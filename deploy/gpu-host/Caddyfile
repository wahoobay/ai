# The stream proxy on the GPU host. CloudFront's VPC origin reaches this on 8080 and adds the
# X-Origin-Verify header only it knows (the same one the dashboard requires). The header is part of
# the stream route's own matcher (Caddy orders directives globally, so a separate "not header" rule
# would run after the proxy), it is stripped before the worker sees it, and it is filtered out of
# every log line. /stream/* goes to the worker with the prefix stripped, unbuffered, so an MJPEG
# stream flows frame by frame for as long as the viewer watches. /hls/* goes to MediaMTX the same way
# (/hls/<path>/index.m3u8 becomes /<path>/index.m3u8). Anything else: 403.
{
	auto_https off
	log default {
		format filter {
			wrap json
			request>headers>X-Origin-Verify delete
		}
	}
}

:8080 {
	@stream {
		path /stream/*
		header X-Origin-Verify {$ORIGIN_VERIFY_SECRET}
	}
	handle @stream {
		uri strip_prefix /stream
		request_header -X-Origin-Verify
		reverse_proxy worker:8081 {
			flush_interval -1
		}
	}
	@hls {
		path /hls/*
		header X-Origin-Verify {$ORIGIN_VERIFY_SECRET}
	}
	handle @hls {
		uri strip_prefix /hls
		request_header -X-Origin-Verify
		reverse_proxy mediamtx:8888
	}
	handle {
		respond 403
	}
}

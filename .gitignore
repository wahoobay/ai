# Data + models (pulled via scripts)
data/test_videos/*.mp4
data/test_videos/*.info.json
data/models/*.zip
data/models/detector_v26/
data/models/classifier_v0_10_2/
data/synthetic/*.csv

# Derived outputs of scripts/build_species_manifest.py — reproducible from
# assets/species.xlsx, so we track the spreadsheet but not the manifest.
assets/species_manifest.json
assets/species_manifest.csv

# Bulk-downloaded community clips (assets/species.xlsx → Drive). Track the
# manifest, the spreadsheet, and the extractor — but not the ~500 MB of
# image/clip downloads. The download_species_clips.py script reproduces them.
assets/community_clips/

# Generated fine-tuning dataset (crops + manifests). Reproducible from
# assets/species.xlsx + community_clips + the detector via
# scripts/build_finetune_dataset_from_clips.py.
data/fine_tune/

# Training runs (checkpoints, history JSON, per-class reports). Each run
# is ~200 MB of weights + a few KB of metrics. Reproducible from the
# script + the fine-tune dataset; we track the metrics into commit
# messages or memory rather than checking weights in.
data/baseline_runs/

# Runtime artifacts
frames/
logs/
pgdata/
*.pid

# Env
.env
.env.local
.dashboard_write_token
*.token

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# IDE
.vscode/
.idea/
.claude/

# Ad-hoc screenshots / scratch images dropped into the repo root
/*.png
/*.jpg
/*.jpeg
/*.webp

# --- site: which location this stack serves ---
# Nothing site-specific lives in the code; these name the site. The same block
# is what the AWS stacks inject (infra repo, locations/<name>.yaml).
LOCATION_ID=wahoobay                 # short id for rows, export filenames, object prefixes
SENSESTREAM_DEPLOYMENT_URI=wahoo_2   # required: the SenseStream deployment readings are tagged with
TZ=America/New_York                  # IANA zone the dashboard renders in (the code's own default is UTC)
CAMERA_METADATA_PATH=/data/camera_metadata.json          # the image ships this file there
NEGATIVE_REGIONS_PATH=/data/camera_negative_regions.json # per-camera no-fish zones (admin UI writes it)
EXPORT_PREFIX=                       # CSV/Parquet filename prefix; empty = LOCATION_ID

# --- video source ---
# Three accepted schemes:
#   file:///abs/path/to/dir            — playlist of mp4 files, looped
#   rtsp://user:pass@host:port/path    — native RTSP
#   http(s)://user:pass@host:port/...  — MJPEG over HTTP, e.g. Axis
#                                        /axis-cgi/mjpg/video.cgi (URL-encode
#                                        '@' in passwords as %40, etc.)
#
# Quote the URL if it contains '&', '?', '*', or any other shell-special
# character — run_*.sh sources this file as bash, and an unquoted '&' is
# read as a background-job operator (the assignment lands in a subshell
# and silently doesn't take effect). Single quotes are always safe.
# Example:
#   VIDEO_SOURCE='rtsp://root:pw@host:5554/axis-media/media.amp?resolution=1280x720&compression=50'
#
# On Axis cameras, `compression` is 0..100 where 0 = least compression
# (best quality) and 100 = most. Default for many Axis presets is
# ~85-90, which is very lossy. We use 50 — middle of the road — to
# keep the inter-process frame size small enough that the inference
# subprocess can drain frames at the camera's native fps. Combined with
# JPEG_QUALITY=92 on the re-encode, the live overlay stays sharp.
#
# Tried 1920x1080 + compression=20 first; per-frame pickle cost over
# the multiprocessing.Queue dropped throughput below 5 fps. 720p halves
# the pixel count and restores native fps. Lift to 1080p again after
# moving the frame hop to shared_memory.
# secret when the URL carries camera credentials (rtsp://user:pass@...)
VIDEO_SOURCE=file:///data/test_videos
VIDEO_LOOP=true
PLAYLIST_SHUFFLE=false
REALTIME_PACING=true

# --- models ---
# Which classifier backend the inference subprocess loads at boot:
#   v2      — DINOv2 ViT-S/14 trained from random init on Wahoo Bay crops
#             + iNat supplements (223 classes). Default.
#   fishial — legacy Fishial v0.10.2 ArcFace + sub-centre + KNN (866 classes),
#             kept available for one-flag revert.
CLASSIFIER_BACKEND=v2

DETECTOR_PATH=/data/models/detector_v26/model.pt

# v2 backend paths (used when CLASSIFIER_BACKEND=v2):
CLASSIFIER_V2_CHECKPOINT=/data/models/classifier_v2/checkpoint_best.pt
CLASSIFIER_V2_CLASSES_JSON=/data/models/classifier_v2/classes.json
CLASSIFIER_V2_ARCH=vit_small_patch14_dinov2
CLASSIFIER_V2_INPUT_SIZE=224
# torch.compile(mode="reduce-overhead") builds a CUDA graph on first call,
# dropping single-crop latency from ~3.7 ms eager to ~0.7 ms. First call
# after worker boot is a long compile (~30 s) — we warm it up at load so
# steady-state frames don't pay that. Set to false to disable for
# debugging (e.g. line-level profiling).
CLASSIFIER_V2_COMPILE=true

# Legacy Fishial paths (used when CLASSIFIER_BACKEND=fishial):
CLASSIFIER_PATH=/data/models/classifier_v0_10_2/model.pt
CLASSIFIER_INFERENCE_MODULE_DIR=/data/models/classifier_v0_10_2

# To pin to a specific physical GPU on a shared box, set CUDA_VISIBLE_DEVICES
# (e.g. =4) and leave DEVICE=cuda:0. Do NOT set DEVICE=cuda:4 directly —
# ultralytics' YOLO mutates CUDA_VISIBLE_DEVICES on init when given a non-zero
# device index, which then breaks the subsequent torch.jit.load of the
# classifier with "device_count() is 1".
CUDA_VISIBLE_DEVICES=
DEVICE=cuda:0
DET_IMGSZ=640
DET_CONF_THRESHOLD=0.25
DET_IOU_THRESHOLD=0.45
CLASSIFIER_TOPK=3
CLASSIFIER_METHOD=natural_centroid
CLASSIFIER_INPUT_H=154
CLASSIFIER_INPUT_W=434

# Top-K filter: any classifier prediction whose softmax probability is
# below this is dropped from the topk list. Practical effect: if the
# top-1 falls below this floor, the detection is persisted with topk=[]
# and the dashboard shows "unknown species" instead of a low-confidence
# guess. Tuned with v2 — anything below ~0.55 softmax is more often
# wrong than right on our 223-class head, so we'd rather show no answer.
MIN_ACCEPT_ACCURACY=0.55

# v2 is fast enough (~0.7 ms/crop) that there's no point gating the
# classifier on a higher det_conf — just let it run on everything the
# detector emits. The MIN_ACCEPT_ACCURACY floor above handles the
# "unknown species" call.
MIN_CLASSIFY_DET_CONF=0.25

# Mixed-precision autocast on the classifier forward. bfloat16 has the
# same throughput as fp16 on H100/H200 with the dynamic range of fp32 —
# numerically safer than fp16. Off | float16 | bfloat16.
CLASSIFIER_AUTOCAST=bfloat16

# --- persistence: database, event log, image saves (tunable) ---
# Either one URL ...                                                  # secret
DATABASE_URL=postgresql://wahoobay:wahoobay@localhost:5432/wahoobay
# ... or its parts, which the services assemble when DATABASE_URL is unset
# (App Runner and Lambda inject DB_PASSWORD straight from Secrets Manager):
#DB_HOST=postgres
#DB_PORT=5432
#DB_NAME=wahoobay
#DB_USER=wahoobay
#DB_PASSWORD=                        # secret
# docker compose creates its Postgres from these and builds every DATABASE_URL
# from them (defaults: wahoobay / wahoobay / wahoobay).
POSTGRES_USER=wahoobay
POSTGRES_PASSWORD=wahoobay           # secret
POSTGRES_DB=wahoobay
EVENTS_LOG_DIR=/data/logs/events
FRAMES_DIR=/data/frames

# Three independent knobs. 0 or false disables the mode.
SAVE_TIMELAPSE_SECONDS=60
SAVE_PER_DETECTION=false
SAVE_INTERESTING_ONLY=true
SAVE_INTERESTING_QUIET_SECONDS=300
SAVE_INTERESTING_MIN_CONF=0.5
# Per-track save throttle. A fish lingering in front of the camera was
# previously triggering a save on every frame it was detected (~30/sec);
# this rate-limits saves to at most once per persistent track per N seconds.
# Set to 0 to disable. New-species frames are exempt (never throttled —
# rare and high-value for the fine-tuning dataset).
SAVE_MIN_TRACK_GAP_SECONDS=1.0

# --- worker http + dashboard ---
WORKER_HTTP_HOST=0.0.0.0
WORKER_HTTP_PORT=8081
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=18080                # bare-metal launchers; the image listens on 8080 (compose maps 18080->8080)
WORKER_URL=http://worker:8081
WORKER_URL_PIER=                    # second (pier) worker; empty = camera toggle falls back to the main one
POLLER_URL=http://sensestream-poller:8082

# How often the dashboard refreshes species_sightings_mat (the materialized
# fish-counter view that backs /api/visitor_stats and /api/species_counts).
# A refresh on a busy cluster takes ~15–20 s; 60 s gives effectively-live
# data; raise to 120–300 s if the DB is under heavy write load.
MATVIEW_REFRESH_INTERVAL_S=60

# --- Google Sheet polling (species + celebrities catalogue) ---
# The Wahoo Bay team maintains the species list + the "Fish named by
# Chatters" celebrity list in a public Google Sheet. The dashboard
# pulls a fresh xlsx export periodically, re-runs the build scripts
# under scripts/, and hot-reloads the in-memory catalogue without a
# restart. New named animals and new species rows show up in the
# dashboard within SHEET_POLL_INTERVAL_HOURS of being added.
#
# The default URL points at the canonical Wahoo Bay sheet; set to an
# empty string to disable polling entirely (the manual
# /api/admin/refresh_sheets endpoint also goes 503 in that case).
# Sheet must be shared "anyone with link" for the export to work
# without auth — verified on 2026-05-17.
SHEET_URL=https://docs.google.com/spreadsheets/d/1Git0Chs3pnEDngCVfDJmQ7noGM90h7uCu3AKecNgiOQ/export?format=xlsx
SHEET_POLL_INTERVAL_HOURS=24

# --- poller: water-quality + weather ---
# Preferred source: Wahoo Bay's public API (no auth). Sonde + on-site weather
# station + Tomorrow.io forecast all come through here.
WAHOOBAY_API_URL=https://api.wahoobay.net
WAHOOBAY_API_ENABLED=1              # set to 0 to skip the public API entirely
WAHOOBAY_SITE_SONDE=3               # /api/v1/sitedata?site=3 → wahoo_2 EXO2 sonde
WAHOOBAY_SITE_WEATHER=1             # /api/v1/sitedata?site=1 → wahoo_1 weather station

# Forecast layer: Open-Meteo (free, no API key, no rate limits) supplies the
# cloud-cover / dew-point / apparent-temp / UV / precip / weather-code columns
# that used to come from Tomorrow.io via Wahoo Bay's proxy. Always runs on
# every tick, independent of which sonde+station source supplied observations.
OPEN_METEO_URL=https://api.open-meteo.com

# Current conditions text: NWS METAR from the airport closest to Wahoo Bay.
# KPMP = Pompano Beach Air Park (~2 mi). KFXE / KFLL are nearby fallbacks.
# api.weather.gov requires a non-empty User-Agent (a contact email is the
# documented convention).
NWS_METAR_STATION=KPMP
NWS_USER_AGENT=wahoobay-dashboard (scoopnisker@gmail.com)

# Site coordinates used for Open-Meteo + NWS gridpoint lookups.
WAHOOBAY_LAT=26.2603
WAHOOBAY_LON=-80.0834

# Fallback source: direct SenseStream observations endpoint (needs auth token).
# When WAHOOBAY_API_ENABLED=0 and SENSESTREAM_AUTH_TOKEN is set, the poller uses
# this path; if both are unavailable the poller emits synthetic stub readings so
# the dashboard's charts keep showing data.
SENSESTREAM_BASE_URL=https://api.sensestream.org
SENSESTREAM_AUTH_TOKEN=             # secret; empty = no direct-SenseStream fetch
SENSESTREAM_WEATHER_DEPLOYMENT_URI=  # tag on weather rows; empty = the sonde deployment (what the dashboard queries)
SENSESTREAM_POLL_INTERVAL_S=300
SENSESTREAM_BACKFILL_MINUTES=60     # window pulled on each tick after the first
SENSESTREAM_INITIAL_BACKFILL_DAYS=30 # one-shot historical window on the first tick
SENSESTREAM_SOURCE_TAG=live
SENSESTREAM_MEASUREMENTS_PATH=/observations/measurements/{uri}
SENSESTREAM_WEATHER_FETCH_URI=      # the weather station's own SenseStream URI for the direct path; empty = skipped
POLLER_HTTP_HOST=0.0.0.0
POLLER_HTTP_PORT=8082

# --- accounts and roles (dashboard auth) ---
# Cookie-based sessions gate every mutation route: the original four
# (POST /api/corrections, /api/alerts/{id}/ack, /api/admin/refresh_sheets,
# /api/admin/negative_regions) plus the account/session-management routes
# under /api/admin/users* and /api/admin/sessions* — see
# docs/architecture.md's URL-surface table for the full list. Reads (the
# public fish view, species counts, etc.) never require login.
# Set to false behind Secure-cookie-incompatible dev setups (plain http://
# localhost); production should leave this true.
DASHBOARD_COOKIE_SECURE=true
# Idle timeout and hard cap for a session. Whichever is sooner wins — a
# session touched every day still expires after the absolute cap.
DASHBOARD_SESSION_TTL_H=12
DASHBOARD_SESSION_ABS_TTL_D=7
# Login lockout: after this many consecutive failures, further attempts on
# that account are rejected (same generic 401) for the lockout window.
DASHBOARD_LOGIN_MAX_FAILS=8
DASHBOARD_LOGIN_LOCKOUT_MIN=15
# Per-IP login rate limit, in attempts per rolling hour. Separate budget
# from registration's — a nonexistent username still pays a full password
# verification (timing-equalisation) and can never trip the per-account
# lockout above, so this is what actually caps the cost an anonymous flood
# can force per address.
DASHBOARD_LOGIN_MAX_PER_IP_H=60
# Self-registration creates a 'pending' account that can read but not write
# until an admin approves it. Set to false to close signups without a code
# change (existing accounts are unaffected).
DASHBOARD_REGISTRATION_OPEN=true
# Per-IP registration rate limit, in accounts per rolling hour.
DASHBOARD_REGISTER_MAX_PER_IP_H=5
# Per-IP cap on password-reset requests, per rolling hour. This is the one
# unauthenticated endpoint that makes the server send mail to an address the
# caller chooses, so an uncapped one is a mail-bombing vector against any
# third party -- and it is your sending domain's reputation that pays.
DASHBOARD_FORGOT_MAX_PER_IP_H=10
# Single-use token lifetimes for password reset / email verification links.
DASHBOARD_RESET_TTL_MIN=30
DASHBOARD_VERIFY_TTL_H=24
# 'manual' backend never actually sends the verification/reset email (fine
# for a lab deployment with no MTA) — the raw link is never logged or
# exposed anywhere, so approve reviewers directly from /admin/users.html
# instead of relying on the email step, and use that page's "Reset link"
# button (POST /api/admin/users/{id}/reset-link) to hand a forgotten-
# password link to the account holder out of band (see "Accounts and
# roles" in docs/operations.md).
#
# Both of the preconditions this file used to list are now satisfied:
# /api/auth/forgot-password is rate limited (DASHBOARD_FORGOT_MAX_PER_IP_H
# above), and starttls() passes an explicit ssl.create_default_context(),
# so the relay's certificate is verified rather than merely encrypted.
#
# Two things that still bite when switching to 'smtp':
#   - DASHBOARD_SMTP_FROM must be at a domain verified with your provider.
#     A university address you don't control DNS for cannot be verified,
#     and sending as one fails that domain's SPF by design.
#   - Use a STARTTLS port (587, or 2587 if egress blocks it). Port 465 is
#     implicit TLS and needs SMTP_SSL, which this mailer does not use --
#     it would fail, then degrade to manual with only a log line to say so.
# Fill the DASHBOARD_SMTP_* block below to actually send mail.
DASHBOARD_MAIL_BACKEND=manual
DASHBOARD_SMTP_HOST=
DASHBOARD_SMTP_PORT=587
DASHBOARD_SMTP_USER=
DASHBOARD_SMTP_PASSWORD=                # secret
DASHBOARD_SMTP_STARTTLS=true
DASHBOARD_SMTP_FROM=noreply@wahoobay.invalid
# Base URL used to build the links inside verification/reset emails —
# must be the address a reviewer's browser can actually reach.
DASHBOARD_PUBLIC_BASE_URL=http://localhost:18080

# --- misc ---
LOG_LEVEL=INFO
JPEG_QUALITY=92
LIVE_STREAM_MAX_FPS=15

# --- drift monitor ---
# frames between frame_stats samples; 30 ≈ 1 Hz at a 30 fps source
FRAME_STATS_EVERY_N_FRAMES=30

# --- autoswitch: fall back to another source when primary goes dark ---
# When FALLBACK_VIDEO_SOURCE is set, the worker measures rolling mean-luma on
# the primary stream and switches to the fallback when the primary is dark
# for sustained period (e.g. nighttime). Hysteresis prevents flapping.
# Leave empty to disable.
FALLBACK_VIDEO_SOURCE=                  # e.g. file:///abs/path/to/test_videos
AUTOSWITCH_DARK_THRESHOLD=25.0          # avg luma below this → switch to fallback
AUTOSWITCH_LIGHT_THRESHOLD=50.0         # avg luma above this → switch back to primary
AUTOSWITCH_SAMPLE_EVERY_N_FRAMES=15     # sample brightness every N frames (~1 Hz at 15 fps)
AUTOSWITCH_WINDOW_SAMPLES=60            # rolling-window length (≈ 60 s at 1 Hz)

# Friendly labels (overrides URL hostname in /stats.current_source and in
# detection_events.source_name). Keeps camera IPs out of public-facing data.
# Empty falls back to the URL's hostname.
SOURCE_LABEL_PRIMARY=                   # e.g. seahivecam
SOURCE_LABEL_FALLBACK=                  # e.g. pier_cam

# --- PTZ poller (off by default; pan/tilt/zoom samples land in ptz_states) ---
# When enabled, polls the camera every PTZ_POLL_INTERVAL_S and joins look-
# direction to detection events at query time. Needs an Operator-or-higher
# account on the camera (not the FAU role on the pier cam — got 401).
PTZ_POLL_ENABLED=false
PTZ_POLL_URL=                                # e.g. https://root:secret@cam/axis-cgi/com/ptz.cgi?query=position&camera=1 ; secret (carries the camera password)
PTZ_POLL_BACKEND=vapix                       # vapix | onvif (onvif TBD)
PTZ_SOURCE_NAME=camera                       # label written into ptz_states.source_name
PTZ_POLL_INTERVAL_S=1.0
PTZ_POLL_TIMEOUT_S=4.0

# --- bbox smoothing (live overlay only; raw detections still flow to DB) ---
# Constant-velocity model: box centre is a blend of the raw detection and a
# motion-predicted position (so a swimming fish's box doesn't lag behind).
# Tune CENTER_ALPHA up (→1) for sharper/more jittery, down (→0) for smoother/more lag.
TRACKER_ENABLED=true
TRACKER_WINDOW_FRAMES=5           # size-smoothing window; centre uses velocity model
TRACKER_IOU_THRESHOLD=0.3
TRACKER_MAX_AGE=1                 # frames to "coast" a track with no new detection
TRACKER_MIN_HITS=1
TRACKER_CENTER_ALPHA=0.6          # 0..1, higher = track the raw detection more tightly
TRACKER_VELOCITY_ALPHA=0.5        # EMA weight for velocity updates
TRACKER_VELOCITY_DECAY=0.8        # per-frame velocity decay while coasting

# ---- Review tool (docs/superpowers/specs/2026-09-24-reviewer-annotation-dataset-design.md) ----
REVIEW_ASSETS_DIR=                   # empty = <repo>/assets
REVIEW_TAXONOMY_CSV=                 # empty = <REVIEW_ASSETS_DIR>/taxonomy.csv
# Connections in the dashboard's database pool. The review pool task holds
# one for up to 30 s per run and the matview refresher one per REFRESH.
DASHBOARD_DB_POOL_MAX=6
# The background task that keeps boxes ready for /review. Set to false (or
# 0, no, off; any case) to stop it (restart the dashboard); the page keeps
# serving what is queued. Any other value leaves it on.
REVIEW_POOL_ENABLED=true
REVIEW_POOL_TOPUP_INTERVAL_S=300
# Per-run limits: index probes, and wall-clock seconds.
REVIEW_POOL_MAX_PROBES=200
REVIEW_POOL_MAX_RUN_S=30
# How many open boxes to keep per species (check lane), and in the identify lane.
REVIEW_POOL_CHECK_OPEN_PER_SPECIES=20
REVIEW_POOL_IDENTIFY_OPEN=500
# No two boxes from the same camera within this many seconds (the
# duplicate guard: frame and track ids restart with the workers).
REVIEW_POOL_SPACING_S=120
# Smallest box offered, in pixels on its shorter side.
REVIEW_MIN_BOX_PX=32
# Unguessed boxes below this detector confidence are not offered.
REVIEW_IDENTIFY_MIN_DET_CONF=0.4
# Crops per species the queue works toward (training set + verified).
REVIEW_TARGET_PER_SPECIES=200
# How long a served box stays held for the volunteer who got it.
REVIEW_CLAIM_S=600
# Days a skipped box stays hidden from the volunteer who skipped it.
REVIEW_SKIP_TTL_DAYS=30
# Share of first answers re-checked blind, and share of servings that are re-checks.
REVIEW_SPOTCHECK_RATE=0.10
REVIEW_SPOTCHECK_SERVE_RATE=0.10
# Where the species catalogue and the training-set counts are read from.
# The defaults are the repo's assets/ and data/ folders.
# REVIEW_ASSETS_DIR=/raid/scratch/dzimmerman2021/wahoobay/assets
# REVIEW_TAXONOMY_CSV=/raid/scratch/dzimmerman2021/wahoobay/assets/taxonomy.csv
# REVIEW_BASELINE_MANIFEST=/raid/scratch/dzimmerman2021/wahoobay/data/fine_tune/_dataset_manifest.json
